    {
      "name": "pid reuse creates a new runtime instance",
      "operator": "notEqual",
      "left": "host-pid-original.agentInstanceId",
      "right": "host-pid-reused.agentInstanceId"
    },
    {
      "name": "pid reuse keeps the existing asset correlation",
      "operator": "equal",
      "left": "host-pid-original.agentCorrelationId",
      "right": "host-pid-reused.agentCorrelationId"
    },
    {
      "name": "two agents share one Docker container",

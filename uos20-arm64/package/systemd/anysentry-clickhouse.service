[Unit]
Description=AnySentry ClickHouse database
After=local-fs.target
Before=anysentry.service

[Service]
Type=simple
User=anysentry
Group=anysentry
WorkingDirectory=/var/lib/anysentry
EnvironmentFile=/etc/anysentry/anysentry.env
ExecStart=/opt/anysentry/clickhouse/bin/clickhouse server --config-file=/opt/anysentry/clickhouse/etc/config.xml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=120s
KillSignal=SIGTERM
LimitNOFILE=262144
MemoryHigh=32G
MemoryMax=40G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/anysentry /var/log/anysentry

[Install]
WantedBy=multi-user.target

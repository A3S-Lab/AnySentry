[Unit]
Description=AnySentry streaming composite judgment worker
Requires=anysentry-redis.service anysentry-clickhouse.service anysentry-kafka-init.service
After=network.target anysentry-redis.service anysentry-clickhouse.service anysentry-kafka-init.service

[Service]
Type=simple
User=anysentry
Group=anysentry
WorkingDirectory=/opt/anysentry/app
EnvironmentFile=/etc/anysentry/anysentry.env
Environment=ANYSENTRY_STREAM_WORKER_ROLE=judge
Environment=NODE_OPTIONS=--max-old-space-size=3072
ExecStart=/opt/anysentry/runtime/node/bin/node /opt/anysentry/app/dist/security-monitoring/stream-worker-main.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=60s
LimitNOFILE=65536
MemoryHigh=4G
MemoryMax=5G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/anysentry

[Install]
WantedBy=multi-user.target


# systemd EnvironmentFile syntax: KEY=value, without shell expansion.
NODE_ENV=production
PORT=29653
ANYSENTRY_WEB_DIR=/opt/anysentry/app/web

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=anysentry
CLICKHOUSE_PASSWORD=__GENERATED__
CLICKHOUSE_DB=anysentry

ANYSENTRY_ADMIN_TOKEN=__GENERATED__
ANYSENTRY_SOURCE_ID=__GENERATED__
ANYSENTRY_INGEST_TOKEN=__GENERATED__
ANYSENTRY_INGEST_URL=http://127.0.0.1:29653/security-center/ingest
A3S_OBSERVER_COLLECTOR_ID=
ANYSENTRY_WORKSPACE_PATH=
ANYSENTRY_HEARTBEAT_SECS=30

# OpenAI-compatible base URL ending in /v1. Leave blank to run L1 only.
ANYSENTRY_LLM_BASE_URL=
ANYSENTRY_LLM_MODEL=
ANYSENTRY_LLM_API_KEY=
ANYSENTRY_LLM_TIMEOUT=30
ANYSENTRY_L3_ENABLED=false
ANYSENTRY_L3_TIMEOUT=180
ANYSENTRY_L3_WORKSPACE=/var/lib/anysentry/l3

ANYSENTRY_SYNTHETIC_FEED=off
ANYSENTRY_ALERTS=on
ANYSENTRY_ALERT_WEBHOOK_URL=
ANYSENTRY_LLM_ENDPOINTS=api.anthropic.com,api.openai.com,api.deepseek.com

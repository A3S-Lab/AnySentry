# systemd EnvironmentFile syntax: KEY=value, without shell expansion.
NODE_ENV=production
PORT=29653
ANYSENTRY_WEB_DIR=/opt/anysentry/app/web
PUBLIC_BASE_PATH=/anysentry

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=anysentry
CLICKHOUSE_PASSWORD=__GENERATED__
CLICKHOUSE_DB=anysentry

ANYSENTRY_ADMIN_TOKEN=__GENERATED__
ANYSENTRY_SOURCE_ID=__GENERATED__
ANYSENTRY_INGEST_TOKEN=__GENERATED__
ANYSENTRY_INGEST_URL=http://127.0.0.1:29653/security-center/ingest
A3S_OBSERVER_COLLECTOR_ID=
ANYSENTRY_WORKSPACE_PATH=
ANYSENTRY_HEARTBEAT_SECS=30
ANYSENTRY_REDIS_URL=redis://127.0.0.1:6379/0
ANYSENTRY_ASYNC_JUDGE=off
ANYSENTRY_FAST_JUDGE_CONCURRENCY=4

# Local Kafka/Flink streaming. All endpoints remain bound to loopback.
ANYSENTRY_STREAMING=on
ANYSENTRY_STREAM_AGENT_ONLY=on
ANYSENTRY_STREAM_BOOTSTRAP_SERVERS=127.0.0.1:9092
ANYSENTRY_STREAM_CANONICAL_TOPIC=anysentry.events.canonical.v1
ANYSENTRY_STREAM_JUDGMENTS_TOPIC=anysentry.judgments.v1
ANYSENTRY_STREAM_EPISODES_TOPIC=anysentry.risk-analysis-batches.v1
ANYSENTRY_STREAM_FINDINGS_TOPIC=anysentry.stream.findings.v1
ANYSENTRY_STREAM_DLQ_TOPIC=anysentry.stream.dlq.v1
ANYSENTRY_SUPPLY_CHAIN_CONTEXT_TOPIC=anysentry.supply-chain.context.v1
ANYSENTRY_FLINK_CANONICAL_GROUP=anysentry-flink-uos-v1
ANYSENTRY_FLINK_JUDGMENTS_GROUP=anysentry-flink-judgments-uos-v1
ANYSENTRY_FLINK_SUPPLY_CHAIN_CONTEXT_GROUP=anysentry-flink-supply-chain-uos-v1
ANYSENTRY_FLINK_STARTUP_MODE=latest
ANYSENTRY_FLINK_PARALLELISM=2
ANYSENTRY_KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Supply-chain scanning is available but disabled until a scanner token and
# intelligence endpoint are configured. This prevents external calls on an
# isolated installation.
ANYSENTRY_SUPPLY_CHAIN=off
ANYSENTRY_SUPPLY_CHAIN_RUNTIME=off
ANYSENTRY_WORKSPACE_SCANNER_TOKEN=
ANYSENTRY_WORKSPACE_SCANNER_TOKENS=
ANYSENTRY_OSV_API_URL=https://api.osv.dev
ANYSENTRY_OSV_INTELLIGENCE_MODE=online
ANYSENTRY_OSV_DATA_REVISION=
ANYSENTRY_OSV_REQUEST_TIMEOUT_MS=20000
ANYSENTRY_OSV_REFRESH_INTERVAL_MS=86400000
ANYSENTRY_SUPPLY_CHAIN_ASSESSMENT_CONCURRENCY=2

ANYSENTRY_COMPOSITE_LLM_URL=
ANYSENTRY_COMPOSITE_LLM_KEY=
ANYSENTRY_COMPOSITE_MODEL=deepseek-v4-flash
ANYSENTRY_COMPOSITE_TIMEOUT_MS=60000
ANYSENTRY_COMPOSITE_CONCURRENCY=2

# OpenAI-compatible base URL ending in /v1. Leave blank to run L1 only.
ANYSENTRY_LLM_BASE_URL=
ANYSENTRY_LLM_MODEL=
ANYSENTRY_LLM_API_KEY=
ANYSENTRY_LLM_TIMEOUT=30
ANYSENTRY_L3_ENABLED=false
ANYSENTRY_L3_TIMEOUT=180
ANYSENTRY_L3_TIMEOUT_MS=180000
ANYSENTRY_L3_CONCURRENCY=2
ANYSENTRY_L3_ATTEMPTS=2
ANYSENTRY_L3_CONTEXT_TOKENS=32768
ANYSENTRY_L3_SKILLS=/opt/anysentry/l3/skills
ANYSENTRY_L3_WORKSPACE=/var/lib/anysentry/l3
A3S_SENTRY_L3_URL=
A3S_SENTRY_L3_MODEL=
A3S_SENTRY_L3_KEY=

ANYSENTRY_SYNTHETIC_FEED=off
ANYSENTRY_ALERTS=on
ANYSENTRY_ALERT_WEBHOOK_URL=
ANYSENTRY_LLM_ENDPOINTS=api.anthropic.com,api.openai.com,api.deepseek.com

# Copy to .env only for an external OpenAI-compatible endpoint. The local fake
# provider needs no credentials and uses the non-secret fixture key internally.
PI_LAB_BASE_URL=http://openai-compatible.example.invalid/v1
PI_LAB_API_KEY=replace-with-a-real-key-outside-git
PI_LAB_MODEL=replace-with-a-supported-model
PI_LAB_EXPECT_FIXTURE=0

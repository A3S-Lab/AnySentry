# AnySentry configuration — copy to `.env` and edit. All values have safe defaults.

# --- HTTP ---
PORT=29653                                   # dashboard + API + /ingest

# --- ClickHouse (durable event store) ---
# If CLICKHOUSE_URL is unset, AnySentry runs in-memory only (no durability across restarts).
CLICKHOUSE_URL=http://clickhouse:8123        # standalone (no compose): http://localhost:8123
CLICKHOUSE_DB=anysentry
CLICKHOUSE_USER=anysentry
CLICKHOUSE_PASSWORD=anysentry

# --- Event sources / enrichment (optional) ---
# Comma-separated host/IP list; agent→endpoint connections to these are surfaced as LLM calls.
# ANYSENTRY_LLM_ENDPOINTS=api.openai.com,api.anthropic.com,api.deepseek.com

# --- Read-only AI identity review (optional) ---
# Agentic review may require several model/tool rounds. The per-request timeout stays below the
# overall budget so provider errors are surfaced before the UI's terminal review timeout.
# ANYSENTRY_IDENTITY_REVIEW_TIMEOUT_MS=120000
# ANYSENTRY_IDENTITY_REVIEW_LLM_TIMEOUT_MS=45000
# ANYSENTRY_IDENTITY_REVIEW_PREFLIGHT_TIMEOUT_MS=15000

# --- Optional restart-surviving model credentials ---
# The policy page can test and apply memory-only keys without a restart. Environment credentials are
# an independent deployment/secret-manager fallback and survive service restarts.
# Fast review: L2 structured judgment + AI identity assistance.
A3S_SENTRY_LLM_URL=http://host.docker.internal:18051/v1
A3S_SENTRY_LLM_MODEL=glm-5.2
A3S_SENTRY_LLM_KEY=
# Deep investigation: L3 Agent only; it never falls back to the fast-review key.
A3S_SENTRY_L3_URL=http://host.docker.internal:18051/v1
A3S_SENTRY_L3_MODEL=glm-5.2
A3S_SENTRY_L3_KEY=

# --- Alerting (optional, platform-side only) ---
# ANYSENTRY_ALERTS=on
# ANYSENTRY_ALERT_WEBHOOK_URL=https://example.com/anysentry-alerts
# ANYSENTRY_ALERT_WEBHOOK_COOLDOWN_SECS=300
# ANYSENTRY_ALERT_INCIDENT_MIN_SEVERITY=high
# ANYSENTRY_ALERT_EVENT_MIN_SEVERITY=critical
# ANYSENTRY_ALERT_AGENT_OPEN_INCIDENT_THRESHOLD=3
# ANYSENTRY_COLLECTOR_STALE_AFTER_SECS=180
# ANYSENTRY_COLLECTOR_DOWN_AFTER_SECS=600
# ANYSENTRY_SOURCE_STALE_AFTER_SECS=600
# ANYSENTRY_SOURCE_DOWN_AFTER_SECS=1800
# ANYSENTRY_SOURCE_TOKEN_ROTATION_DAYS=90
# ANYSENTRY_REMEDIATION_OVERDUE_SCAN_SECS=60

# --- Management API auth (optional) ---
# When set, control-plane mutations such as policy saves, Source management, Incident/Alert updates,
# Maintenance windows, Notification routes, Objectives, and Remediation edits require this token.
# Read APIs and producer paths (/ingest, Collector heartbeat, Source check-in) keep using their own
# Source tokens and remain separate from management auth.
# ANYSENTRY_ADMIN_TOKEN=change-me-long-random-token

# --- Agent Interaction encrypted content (disabled by default) ---
# Content can come from an explicitly selected local Runtime adapter or from AnySentry Observer's
# exact-binary Codex/Rustls probe. Both use ContentStore encryption and the independent Interaction
# durable-ack lane; neither reads an AgentSight service or database. Generate the gitignored 0600
# credential file with `pnpm bootstrap:agent-interaction-content`; Compose loads it automatically.
# ANYSENTRY_INTERACTION_CONTENTS=off
# ANYSENTRY_INTERACTION_CONTENT_CAPTURE_MODE=local_runtime
# ANYSENTRY_INTERACTION_CONTENT_KEY_TENANT=tenant_default
# ANYSENTRY_INTERACTION_CONTENT_KEY_VERSION=v1
# ANYSENTRY_INTERACTION_CONTENT_KEY=base64-encoded-32-byte-key
# ANYSENTRY_INTERACTION_RAW_VIEW=off
# ANYSENTRY_INTERACTION_RAW_VIEW_TOKEN=separate-long-random-capability
# UNSAFE local convenience only: bypasses management/raw-view credentials for read-only
# conversation list, detail, and automatic plaintext display. It is ignored unless the content
# capture mode is local_runtime or isolated_fixture. Never set this in a shared/production deploy.
# ANYSENTRY_INTERACTION_UNSAFE_LOCAL_DIRECT_VIEW=off
# ANYSENTRY_INTERACTION_CONTENT_ORPHAN_TTL_MS=86400000

# --- AnySentry Observer auto-discovered Codex/Rustls request capture (local/controlled only) ---
# Default metadata mode never reads a TLS payload buffer. To capture the user message that Codex
# actually sends to the model, all gates below must be set and the Observer must start before the
# target Codex process so WebSocket compression state is observed from the handshake.
# For a source checkout, build Observer from /home/zhongyule/code/Observer and pin both images;
# these are AnySentry/Observer images, not AgentSight runtime or database dependencies.
# ANYSENTRY_OBSERVER_COLLECTOR_IMAGE=a3s-observer:local
# ANYSENTRY_OBSERVER_WRAPPER_IMAGE=anysentry-observer-wrapper:runtime-local
# A3S_OBSERVER_INTERACTION_CAPTURE_MODE=runtime_payload
# A3S_OBSERVER_ENVIRONMENT=controlled_capture
# A3S_OBSERVER_ALLOW_RUNTIME_PAYLOAD=I_UNDERSTAND_MODEL_REQUEST_CAPTURE
# A3S_OBSERVER_RUNTIME_AUTO_DISCOVER=1
# A3S_OBSERVER_RUNTIME_BINARY=/optional/diagnostic/override/inside-observer
# A3S_OBSERVER_RUNTIME_PROVIDER_HOSTS=chatgpt.com,api.openai.com
# ANYSENTRY_INTERACTIONS=on

# --- Local Agent record tracking (read-only, disabled by default) ---
# Reads native Codex/Claude Code JSONL, A3S Code JSON, and Gemini CLI JSON/JSONL
# Session files for the Record Tracking page. This lane does not use eBPF
# and does not prove that a declared Tool Call reached the kernel. In containers, mount only the
# sessions directory read-only and set the path to that in-container mount.
# ANYSENTRY_LOCAL_RECORD_TRACKING=off
# ANYSENTRY_LOCAL_CODEX_SESSIONS_DIR=/host-agent-state/codex/sessions
# ANYSENTRY_LOCAL_A3S_SESSIONS_DIR=/host-agent-state/a3s/tui/sessions
# ANYSENTRY_LOCAL_CLAUDE_SESSIONS_DIR=/host-agent-state/claude/projects
# ANYSENTRY_LOCAL_GEMINI_SESSIONS_DIR=/host-agent-state/gemini/tmp
# ANYSENTRY_LOCAL_KIMI_SESSIONS_DIR=/host-agent-state/kimi/sessions
# OpenCode: mount the whole data directory read-only, including opencode.db-wal/-shm.
# Default: $XDG_DATA_HOME/opencode or ~/.local/share/opencode. Multiple roots use ':' on Linux.
# ANYSENTRY_LOCAL_OPENCODE_DATA_DIR=/host-agent-state/opencode
# ANYSENTRY_LOCAL_OPENCODE_DATA_DIRS=/host-agent-state/opencode:/host-agent-state/opencode-other
# Optional local-only process evidence. The API must receive an explicitly scoped host process
# view; never enable this merely against the container's private /proc namespace.
# ANYSENTRY_LOCAL_PROCESS_TRACKING=off
# ANYSENTRY_LOCAL_PROCESS_ROOT=/proc
# ANYSENTRY_LOCAL_CODEX_SESSIONS_HOST_DIR=/home/user/.codex/sessions
# ANYSENTRY_LOCAL_A3S_SESSIONS_HOST_DIR=/home/user/project/.a3s/tui/sessions
# ANYSENTRY_LOCAL_CLAUDE_SESSIONS_HOST_DIR=/home/user/.claude/projects
# ANYSENTRY_LOCAL_GEMINI_SESSIONS_HOST_DIR=/home/user/.gemini/tmp
# ANYSENTRY_LOCAL_KIMI_SESSIONS_HOST_DIR=/home/user/.kimi/sessions
# Kimi closes each Wire append; scoped FileAccess plus exec/exit enables Session binding.
# FORWARD_FILE_INCLUDE_PATHS=/home/user/.kimi/sessions
# Short-lived eBPF Session-file attribution canary only. This is evaluated in the Observer
# collector before FileAccess serialization; leave empty during ordinary operation.
# A3S_OBSERVER_FILE_INCLUDE_PATHS=/home/user/.gemini/tmp
# ANYSENTRY_LOCAL_PROCESS_CACHE_MS=10000
# ANYSENTRY_LOCAL_RECORD_MAX_FILES=500

# --- Kubernetes identity enrichment ---
# Auto-enabled when running in-cluster (resolves pod-uid -> real agent name via the K8s API); a no-op
# standalone. Set =off to disable it even in-cluster.
# ANYSENTRY_KUBE_ENRICH=off
# ANYSENTRY_AGENT_NAMESPACES=default          # comma-separated namespaces to read pods from

# --- Demo ---
# ANYSENTRY_SYNTHETIC_FEED=on                 # self-driving demo load (still really judged)

# --- Forwarder (scripts/observer-forward.js) ---
# ANYSENTRY_INGEST_URL=http://localhost:29653/security-center/ingest
# A3S_OBSERVER_COLLECTOR_ID=node-a             # attached to forwarded events; observer also emits CollectorHeartbeat
# A3S_NODE_NAME=node-a
# ANYSENTRY_SOURCE_ID=src_xxx                  # optional: created in /sources
# ANYSENTRY_SOURCE_NAME=node-a-observer
# ANYSENTRY_SOURCE_TYPE=observer               # observer | forwarder | webhook | otel | custom
# ANYSENTRY_INGEST_TOKEN=ansrc_xxx             # optional: source token, only shown when created/rotated
# ANYSENTRY_HEARTBEAT_SECS=30                  # set 0 to disable forwarder self-heartbeats
# ANYSENTRY_HEARTBEAT_URL=http://localhost:29653/security-center/collectors/heartbeat
# FORWARD_FILTER_MODE=enforce                  # enforce | shadow; shadow reports would-drop metrics
# FORWARD_AGENT_ALLOWLIST=codex                # optional exact Agent IDs; benchmark-only scope
# FORWARD_RETAIN_UNKNOWN=true                 # keep Unknown for missed-Agent review (recommended)
# FORWARD_RETAIN_NON_AGENT=false              # reviewed Non-Agent events stop at the collector
# FORWARD_NOISE_POLICY=balanced               # balanced filters routine /proc,/sys,/run,/dev FileAccess

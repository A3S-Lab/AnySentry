{
  "name": "anysentry-website",
  "version": "0.0.0",
  "description": "Official multilingual website and documentation for AnySentry.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "RSPRESS_PERSISTENT_CACHE=false rspress build",
    "check": "tsc --noEmit && node scripts/check-language-parity.mjs",
    "check:site": "node scripts/check-built-site.mjs",
    "dev": "rspress dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "rspress preview"
  },
  "dependencies": {
    "@rspress/core": "^2.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  }
}

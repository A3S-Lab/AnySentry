[Unit]
Description=AnySentry Kafka event stream
After=network.target

[Service]
Type=simple
User=anysentry
Group=anysentry
WorkingDirectory=/opt/anysentry/kafka
EnvironmentFile=/etc/anysentry/anysentry.env
ExecStart=/opt/anysentry/run-kafka.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=60s
LimitNOFILE=65536
MemoryHigh=3G
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/anysentry

[Install]
WantedBy=multi-user.target

